{
  "installCommand": "npx pnpm@11.17.0 install",
  "buildCommand": "npx pnpm@11.17.0 --filter @pos/api build:vercel && npx pnpm@11.17.0 --filter @pos/web build",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "functions": {
    "apps/api/api/index.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "apps/api/api/index.ts"
    }
  ]
}

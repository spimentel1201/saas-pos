# Base de datos principal
# Para Vercel/prod: usa connection pooling (pgbouncer, Supabase, Neon, etc.)
# Ejemplo Supabase: postgresql://user:pass@host:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/pos_saas?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:15432/pos_saas_shadow

# Redis (opcional — solo necesario si usas BullMQ para colas/jobs)
# REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Stripe (opcional para MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (upload directo desde frontend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=pos-products-unsigned

# App
APP_BASE_URL=http://localhost:3001
API_PORT=3000
TENANT_BASE_DOMAIN=localhost

# Observabilidad (opcional)
SENTRY_DSN=

# Base de datos principal (tablas compartidas: tenants, users, subscriptions, tenants_users)
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/pos_saas?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:15432/pos_saas_shadow

# Redis (opcional — solo necesario si usas BullMQ para colas/jobs)
# REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Stripe (suscripciones SaaS — opcional para MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Cloudinary (imagenes producto — upload directo desde frontend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=pos-products-unsigned

# App
APP_BASE_URL=http://localhost:3001
API_PORT=3000
TENANT_BASE_DOMAIN=localhost

# Observabilidad (opcional)
SENTRY_DSN=
